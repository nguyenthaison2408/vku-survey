{
  "name": "vku-field-survey",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name vku-survey --branch main",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:android": "npx cap run android",
    "cap:build": "npm run build && npx cap sync",
    "build:apk": "npm run cap:build && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "idb": "^8.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "^10.4.19",
    "docx": "^9.7.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.0"
  }
}
